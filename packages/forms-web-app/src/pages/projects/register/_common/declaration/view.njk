{% extends "layouts/default.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageHeading = t('register.declaration.pageHeading')%}
{% set whoRegisteringFor = t('register.whoRegisteringFor.' + key) %}
{% set commonPageTitle = t('register.index.pageTitle')%}
{% set title = pageHeading + ' - ' + whoRegisteringFor + ' - ' + commonPageTitle %}

{% block pageTitle %}
	{{ title }}
{% endblock %}

{% block content %}
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds-from-desktop">
			<h1 class="govuk-heading-xl">
				{{ pageHeading }}
			</h1>

			<p class="govuk-body">
				{{ t('register.declaration.paragraph1') }}
			</p>

			<ul class="govuk-list govuk-list--bullet">
				<li>{{ t('register.declaration.' + key + '.listItem1') | safe }}</li>
				<li>{{ t('register.declaration.' + key + '.listItem2') }}</li>
				<li>{{ t('register.declaration.' + key + '.listItem3') | safe }}</li>
			</ul>

			{% if key === 'agent' %}
				<p class="govuk-body">
					{{ t('register.declaration.agent.paragraph1') }}
				</p>

				<ul class="govuk-list govuk-list--bullet">
					<li>{{ t('register.declaration.agent.listItem4') }}</li>
					<li>{{ t('register.declaration.agent.listItem5') }}</li>
				</ul>
			{% endif %}

			{{ govukInsetText({ text: t('register.declaration.insetText') }) }}

			<a class="govuk-button" data-cy="button-accept-and-register" href="{{ nextPageUrl }}">
				{{ t('register.declaration.acceptAndSubmit') }}
			</a>
		</div>
	</div>
{% endblock %}
