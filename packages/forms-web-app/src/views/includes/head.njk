<link href="/public/stylesheets/main.css" media="all" rel="stylesheet" type="text/css">

{% if googleAnalyticsId %}
	<!-- Global site tag (gtag.js) - Google Analytics -->
	<script {% if cspNonce %}nonce={{ cspNonce }}{% endif %}>
		window.dataLayer = window.dataLayer || [];

		function gtag() {
			dataLayer.push(arguments);
		}

		gtag('js', new Date());
		gtag('config', '{{ googleAnalyticsId | safe }}');

	</script>
	<script id="gaId" type='text/plain' {% if cspNonce %}nonce={{ cspNonce }}{% endif %}>
		{{ googleAnalyticsId }}
	</script>
{% endif %}


{% if isHomePage %}
<script type="application/ld+json" {% if cspNonce %}nonce="{{ cspNonce }}"{% endif %}>
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Find a National Infrastructure Project",
  "url": "https://national-infrastructure-consenting.planninginspectorate.gov.uk"
}
</script>
{% endif %}
